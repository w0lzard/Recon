<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 splash: themed background, dark circular plate, mark centred (design 2d/2e). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item android:gravity="center" android:width="160dp" android:height="160dp">
        <shape android:shape="oval"><solid android:color="@color/splash_plate" /></shape>
    </item>
    <item android:drawable="@drawable/ic_reticle" android:gravity="center" android:width="160dp" android:height="160dp" />
</layer-list>

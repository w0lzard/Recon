<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Shown by installSplashScreen() while the app starts, then swapped for Theme.Recon. -->
    <style name="Theme.Recon.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Recon</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>

    <style name="Theme.Recon" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- D27: follows the device's dark mode, so the sign-in WebView reports prefers-color-scheme: dark to Google's page. -->
        <item name="android:isLightTheme" tools:targetApi="q">@bool/light_bars</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>

    <!-- Share sheet: a see-through window; the Compose bottom sheet draws its own scrim. -->
    <style name="Theme.Recon.Sheet" parent="Theme.Recon">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
